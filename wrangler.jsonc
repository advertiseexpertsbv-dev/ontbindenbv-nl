/**
 * Cloudflare Workers-configuratie voor ontbindenbv.nl (TanStack Start).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ontbindenbv-nl",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Nog niet live. Livegang zoals belastingbemiddelaar.nl: worker-routes ontbindenbv.nl/* en www.ontbindenbv.nl/* met Proxied
	// A-records (geen custom domains). Tot die tijd alleen workers.dev als test-URL (robots: Disallow, X-Robots-Tag noindex).
	"workers_dev": true,
	// Dagelijks om 03:15 UTC: persoonsgegevens ouder dan de bewaartermijn (5 jaar) opschonen, zie src/server/bewaartermijn.ts
	"triggers": {
		"crons": ["15 3 * * *"]
	},
	// Cookieloze bezoekersmeting; dataset gedeeld met de andere sites, uitgelezen door de Advertisexperts-hub (site-sleutel 'obv')
	"analytics_engine_datasets": [
		{ "binding": "BEZOEKEN", "dataset": "site_bezoeken" }
	],
	// CRM BBase buiten het request-pad, zoals belastingbemiddelaar.nl: de submit zet alleen het lead-id in de wachtrij, deze Worker
	// is ook de consumer (`queue` in src/server.ts → src/server/crm.ts). Zonder secret CRM_WEBHOOK_SECRET gaat er niets naar BBase.
	// De wachtrij maakt de deploy-workflow aan als hij nog niet bestaat.
	"queues": {
		"producers": [{ "binding": "CRM_QUEUE", "queue": "ontbindenbv-crm" }],
		"consumers": [{ "queue": "ontbindenbv-crm", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 6, "max_concurrency": 2 }]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ontbindenbv-db",
			"database_id": "5c4f8c21-690b-48ce-b303-c797ed246e86",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// ontbindenbv.nl is geverifieerd in Resend.
		"RESEND_FROM": "OntbindenBV.nl <info@ontbindenbv.nl>",
		// Zelfde ontvangers als belastingbemiddelaar.nl (besluit Steven 2026-11-09: "zelfde koppelingen")
		"NOTIFICATIE_EMAIL": "info@ontbindenbv.nl,maurice@sea-experts.nl",
		"INTAKE_NOTIFICATIE_EMAIL": "info@ontbindenbv.nl",
		// CRM BBase: eigen hook voor ontbindenbv.nl (2026-11-10). Het geheim (header x-obv-secret) is de secret CRM_WEBHOOK_SECRET.
		"CRM_WEBHOOK_URL": "https://crm.belastingbemiddelaar.nl/api/public/hooks/ontbindenbv"
	}
	// Secrets (wrangler secret put … --name ontbindenbv-nl): RESEND_API_KEY, CRM_WEBHOOK_SECRET (CRM BBase, header x-obv-secret), ZAPIER_WEBHOOK_URL (optioneel). HubSpot staat uit.
}
