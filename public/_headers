# Cache- en beveiligingsheaders voor statische bestanden (Cloudflare Workers Assets).
# De HTML en de worker-antwoorden krijgen dezelfde beveiligingsheaders in src/server.ts.
# Bewust geen Content-Security-Policy en geen HSTS: GTM, HubSpot en YouTube moeten blijven werken en het
# echte domein is nog niet omgezet.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Gehashte bundels van Vite: de bestandsnaam wijzigt bij elke wijziging
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Lettertypes: bij vervanging een nieuwe bestandsnaam gebruiken
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Afbeeldingen hebben geen hash in de naam: een week cache, daarna op de achtergrond verversen
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Icons op de standaardlocatie (zonder hash): zelfde beleid als de afbeeldingen
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Interne beslisboom: niet indexeren. De pagina heeft ook een noindex-meta; robots.txt blokkeert hem bewust NIET meer,
# want Google leest een noindex alleen op een pagina die het mag ophalen (SEO-03). De worker-pagina's /bedankt/ en
# /intake-nieuwe-klant/ krijgen dezelfde header in src/server.ts.
/bizzi/*
  X-Robots-Tag: noindex, nofollow
